# Copy this file to .env and fill in real values.
# .env is gitignored.

# Database
DATABASE_URL=postgresql+psycopg://happyhour:happyhour_dev@localhost:5432/happyhour

# JWT signing
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30

# Email (SendGrid)
# Get a free API key at https://sendgrid.com/ (free tier: 100 emails/day)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@happyhour.app

# Anthropic API for LLM extraction (used by scanner)
ANTHROPIC_API_KEY=

# Yelp Fusion API key — venue discovery (free at https://docs.developer.yelp.com/)
YELP_API_KEY=

# Google Places API key (Phase 2 — optional for now)
GOOGLE_PLACES_API_KEY=

# Apple Push Notifications (filled in Week 2)
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=app.happyhour.ios
APNS_USE_SANDBOX=true

# CORS — list of allowed origins (iOS app uses no origin, simulator uses http://localhost)
CORS_ORIGINS=*
